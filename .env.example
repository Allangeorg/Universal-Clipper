# Optional local data and upload configuration
CLIPPER_DATA_DIR=./data
MAX_UPLOAD_MB=4096

# FFmpeg executable names or absolute paths
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional environment-based API keys for headless use.
# Prefer entering keys in Settings, where they are saved in the OS credential vault.
# Never commit a real .env file or API key.
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
